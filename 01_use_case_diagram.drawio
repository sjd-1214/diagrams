                <mxCell id="5D50KN5zPrAvzWpnFaVA-9" value="&lt;b&gt;IntelliSwarm System&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontSize=18;fontFamily=Helvetica;fillColor=none;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="137" y="53" width="1464" height="946" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-10" value="&lt;b&gt;UC-01: Start Simulation&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-01] Start Simulation Environment&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator executes ./start.sh or clicks 'Start Simulation' in GCS&#10;Actors: Researcher/Operator&#10;Description: Operator starts full simulation stack: Docker, PX4 SITL (4 instances), Gazebo Harmonic, Micro XRCE DDS Agent, rosbridge, and ROS 2 nodes.">
                    <mxGeometry x="240" y="130" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-11" value="&lt;b&gt;UC-02: Stop Simulation&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-02] Stop Simulation Environment&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Stop' in GCS or runs ./start.sh stop&#10;Actors: Researcher/Operator&#10;Description: Operator gracefully stops simulation stack: lands active drones, terminates ROS 2 nodes and PX4 instances, shuts down Gazebo, removes Docker container.">
                    <mxGeometry x="240" y="220" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-12" value="&lt;b&gt;UC-03: Switch Airframe&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-03] Switch Airframe Model&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator selects airframe from GCS dropdown (POST /api/sim/airframe)&#10;Actors: Researcher/Operator&#10;Description: Hot swaps drone airframe (x500, x500_mono_cam, iris, typhoon_h480) without full restart. Respawns PX4 instances with new model.">
                    <mxGeometry x="618" y="179" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-13" value="&lt;b&gt;UC-04: Spawn Swarm&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-04] Place Bases and Spawn Swarm&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks map to place bases, then clicks 'Confirm Bases'&#10;Actors: Researcher/Operator&#10;Description: Operator places attacker and defender base positions on GCS map (NED coordinates). Drones reposition to formation around bases.">
                    <mxGeometry x="240" y="355" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-14" value="&lt;b&gt;UC-05: Configure Attack&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-05] Configure Attack Scenario&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator selects attack parameters in GCS, or batch runner requests randomized condition&#10;Actors: Researcher/Operator&#10;Description: Configures active cyberattack condition: Jamming, GPS Spoofing, False Data Injection, or DDoS with intensity, radius, start time, and duration.">
                    <mxGeometry x="240" y="450" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-15" value="&lt;b&gt;UC-08: Abort Mission&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-08] Abort/Reset Active Mission&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Reset Mission' or 'Stop'&#10;Actors: Researcher/Operator&#10;Description: Aborts active mission immediately. SwarmCoordinator stops guidance loop, publishes LAND command within 100ms, and resets mission state to idle.">
                    <mxGeometry x="237" y="702" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-16" value="&lt;b&gt;UC-06: Launch Swarm Duel&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-06] Launch 2v2 Swarm Duel Mission&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Start Duel' in SwarmDuelTab&#10;Actors: Researcher/Operator&#10;Description: Launches mission with 2 attackers vs 2 defenders. Arms 4 aircraft in OFFBOARD mode. SwarmCoordinator runs 10 Hz guidance loop using fused sensor tracks only.">
                    <mxGeometry x="660" y="600" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-17" value="&lt;b&gt;UC-07: Launch 1v1 Duel&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-07] Launch 1v1 Attack Defend Mission&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator clicks 'Start Mission' in MissionControlTab&#10;Actors: Researcher/Operator&#10;Description: Launches 1v1 mission (1 attacker vs 1 defender). Respawns aircraft at bases, arms, climbs to cruise altitude with setpoints streamed from GCS over WebSocket.">
                    <mxGeometry x="319" y="540" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-18" value="&lt;b&gt;UC-09: Set Weather&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-09] Set Weather Conditions&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator adjusts wind/weather sliders in EnvironmentTab&#10;Actors: Researcher/Operator&#10;Description: Configures wind speed and direction in Gazebo. Degrades EO/IR sensor detection probability proportionally (radar remains weather resistant).">
                    <mxGeometry x="230" y="850" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-19" value="&lt;b&gt;UC-12: Control Drone&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-12] Manually Control Single Drone&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator uses MissionControlTab manual flight controls&#10;Actors: Researcher/Operator&#10;Description: Manually arms, disarms, sends position setpoints, or lands individual drones outside of autonomous mission mode.">
                    <mxGeometry x="580" y="850" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-20" value="&lt;b&gt;UC-10: Monitor Telemetry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-10] Monitor Live Swarm Telemetry&#10;Priority: High | Criticality: Essential&#10;Trigger: Continuous while GCS is open at localhost:5173&#10;Actors: Researcher/Operator&#10;Description: Real-time 3D drone positions, velocities, battery levels, and mission status at 10 Hz via rosbridge WebSocket (/swarm/global_state).">
                    <mxGeometry x="980" y="130" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-21" value="&lt;b&gt;UC-11: View Fused Tracks&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-11] View Fused Sensor Tracks&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator opens Sensor Panel in GCS&#10;Actors: Researcher/Operator&#10;Description: Displays fused sensor track overlay comparing estimated positions vs ground truth, radar/EO-IR detection ranges, and fusion uncertainty.">
                    <mxGeometry x="980" y="220" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-22" value="&lt;b&gt;UC-13: Record Telemetry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-13] Record Episode Telemetry&#10;Priority: High | Criticality: Essential&#10;Trigger: Mission starts (auto log) or operator clicks 'Start Recording'&#10;Actors: Researcher/Operator&#10;Description: Telemetry_logger records mission events, 4-drone telemetry, fused tracks, attack conditions, and outcome into SQLite database at 10 Hz.">
                    <mxGeometry x="980" y="298" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-23" value="&lt;b&gt;UC-14: Replay Episode&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-14] Replay Logged Episode&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator selects past run from log browser&#10;Actors: Researcher/Operator&#10;Description: Replays recorded episode timeline in GCS. Reconstructs drone positions, sensor state, and events with scrub, pause, and speed controls.">
                    <mxGeometry x="980" y="409" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-24" value="&lt;b&gt;UC-15: Query Telemetry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-15] Query Logged Data by Filter&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator applies filter criteria in log browser&#10;Actors: Researcher/Operator&#10;Description: Queries database across multiple episodes filtered by attack type, outcome, or time range. Computes aggregate summary statistics.">
                    <mxGeometry x="980" y="500" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-25" value="&lt;b&gt;UC-16: Run Batch Episodes&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-16] Run Headless Batch Episodes&#10;Priority: Medium | Criticality: Important&#10;Trigger: Training script or operator requests N batch episodes&#10;Actors: Batch Runner&#10;Description: Automated script executes N episodes end-to-end on real PX4/Gazebo/ROS 2 stack in headless Docker with seeded scenarios and full logging.">
                    <mxGeometry x="974" y="740" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-26" value="&lt;b&gt;UC-17: Evaluate Defender&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-17] Evaluate Defender Performance&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator requests evaluation of specific defender agent&#10;Actors: Researcher/Operator&#10;Description: Evaluates RL-trained or rule-based defender against standardized held-out test scenarios. Outputs comparison metrics.">
                    <mxGeometry x="980" y="591" width="275" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5D50KN5zPrAvzWpnFaVA-27" value="&lt;b&gt;UC-18: Train RL Agent&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;align=center;fontColor=#000000;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-18] Train RL Defender Agent&#10;Priority: Medium | Criticality: Important&#10;Trigger: Training script invoked&#10;Actors: Batch Runner&#10;Description: Gymnasium-wrapped environment trains defender policy using PPO and Stable Baselines3. Defender observes only fused sensor data.">
                    <mxGeometry x="980" y="860" width="275" height="60" as="geometry"/>
                </mxCell>
