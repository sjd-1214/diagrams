                <mxCell id="5D50KN5zPrAvzWpnFaVA-6" value="&lt;b&gt;Batch Runner&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#000000;strokeWidth=2;fontSize=16;fontFamily=Helvetica;fontColor=#000000;fontStyle=1;" parent="1" vertex="1">
