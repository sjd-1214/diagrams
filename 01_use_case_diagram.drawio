<mxfile host="65bd71144e">
    <diagram name="Use Case Diagram: System Architecture &amp; Stakeholder Interactions" id="yHc_-E5KIfxNISrc30a3">
        <mxGraphModel dx="56" dy="305" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1789" pageHeight="1180" background="none" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" value="&lt;b&gt;Use Case Diagram: IntelliSwarm Platform&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#000000;fontSize=26;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="22" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;IntelliSwarm Simulation Platform&lt;/b&gt;" style="shape=rect;html=1;whiteSpace=wrap;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;fontSize=21;fontFamily=Helvetica;fillColor=none;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="74" width="1220" height="1012" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;UC-01 Start Simulation Environment&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-01] Start Simulation Environment&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator executes ./start.sh or clicks 'Start Simulation' in GCS&#10;Actors: Researcher/Operator&#10;Description: Operator starts full simulation stack: Docker, PX4 SITL (4 instances), Gazebo Harmonic, Micro XRCE DDS Agent, rosbridge, and ROS 2 nodes.">
                    <mxGeometry x="400" y="120" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;UC-02 Stop Simulation Environment&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-02] Stop Simulation Environment&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Stop' in GCS or runs ./start.sh stop&#10;Actors: Researcher/Operator&#10;Description: Operator gracefully stops simulation stack: lands active drones, terminates ROS 2 nodes and PX4 instances, shuts down Gazebo, removes Docker container.">
                    <mxGeometry x="400" y="200" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;UC-03 Switch Airframe Model&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-03] Switch Airframe Model&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator selects airframe from GCS dropdown (POST /api/sim/airframe)&#10;Actors: Researcher/Operator&#10;Description: Hot swaps drone airframe (x500, x500_mono_cam, iris, typhoon_h480) without full restart. Respawns PX4 instances with new model.">
                    <mxGeometry x="400" y="280" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;b&gt;UC-04 Place Bases and Spawn Swarm&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-04] Place Bases and Spawn Swarm&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks map to place bases, then clicks 'Confirm Bases'&#10;Actors: Researcher/Operator&#10;Description: Operator places attacker and defender base positions on GCS map (NED coordinates). Drones reposition to formation around bases.">
                    <mxGeometry x="400" y="410" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;UC-05 Configure Attack Scenario&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-05] Configure Attack Scenario&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator selects attack parameters in GCS, or batch runner requests randomized condition&#10;Actors: Researcher/Operator&#10;Description: Configures active cyberattack condition: Jamming, GPS Spoofing, False Data Injection, or DDoS with intensity, radius, start time, and duration.">
                    <mxGeometry x="400" y="490" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;UC-09 Set Weather Conditions&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-09] Set Weather Conditions&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator adjusts wind/weather sliders in EnvironmentTab&#10;Actors: Researcher/Operator&#10;Description: Configures wind speed and direction in Gazebo. Degrades EO/IR sensor detection probability proportionally (radar remains weather resistant).">
                    <mxGeometry x="400" y="570" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="&lt;b&gt;UC-12 Manually Control Single Drone&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-12] Manually Control Single Drone&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator uses MissionControlTab manual flight controls&#10;Actors: Researcher/Operator&#10;Description: Manually arms, disarms, sends position setpoints, or lands individual drones outside of autonomous mission mode.">
                    <mxGeometry x="400" y="650" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;b&gt;UC-06 Launch 2v2 Swarm Duel&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-06] Launch 2v2 Swarm Duel Mission&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Start Duel' in SwarmDuelTab&#10;Actors: Researcher/Operator&#10;Description: Launches mission with 2 attackers vs 2 defenders. Arms 4 aircraft in OFFBOARD mode. SwarmCoordinator runs 10 Hz guidance loop using fused sensor tracks only.">
                    <mxGeometry x="400" y="790" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="&lt;b&gt;UC-07 Launch 1v1 Attack Defend&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-07] Launch 1v1 Attack Defend Mission&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator clicks 'Start Mission' in MissionControlTab&#10;Actors: Researcher/Operator&#10;Description: Launches 1v1 mission (1 attacker vs 1 defender). Respawns aircraft at bases, arms, climbs to cruise altitude with setpoints streamed from GCS over WebSocket.">
                    <mxGeometry x="400" y="870" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="&lt;b&gt;UC-08 Abort or Reset Active Mission&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-08] Abort/Reset Active Mission&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator clicks 'Reset Mission' or 'Stop'&#10;Actors: Researcher/Operator&#10;Description: Aborts active mission immediately. SwarmCoordinator stops guidance loop, publishes LAND command within 100ms, and resets mission state to idle.">
                    <mxGeometry x="400" y="950" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="&lt;b&gt;UC-10 Monitor Live Swarm Telemetry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-10] Monitor Live Swarm Telemetry&#10;Priority: High | Criticality: Essential&#10;Trigger: Continuous while GCS is open at localhost:5173&#10;Actors: Researcher/Operator&#10;Description: Real-time 3D drone positions, velocities, battery levels, and mission status at 10 Hz via rosbridge WebSocket (/swarm/global_state).">
                    <mxGeometry x="1180" y="200" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="&lt;b&gt;UC-11 View Fused Sensor Tracks&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-11] View Fused Sensor Tracks&#10;Priority: High | Criticality: Essential&#10;Trigger: Operator opens Sensor Panel in GCS&#10;Actors: Researcher/Operator&#10;Description: Displays fused sensor track overlay comparing estimated positions vs ground truth, radar/EO-IR detection ranges, and fusion uncertainty.">
                    <mxGeometry x="1180" y="280" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="&lt;b&gt;UC-14 Replay Logged Episode&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-14] Replay Logged Episode&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator selects past run from log browser&#10;Actors: Researcher/Operator&#10;Description: Replays recorded episode timeline in GCS. Reconstructs drone positions, sensor state, and events with scrub, pause, and speed controls.">
                    <mxGeometry x="1180" y="360" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="&lt;b&gt;UC-15 Query Logged Data by Filter&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-15] Query Logged Data by Filter&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator applies filter criteria in log browser&#10;Actors: Researcher/Operator&#10;Description: Queries database across multiple episodes filtered by attack type, outcome, or time range. Computes aggregate summary statistics.">
                    <mxGeometry x="1180" y="440" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="&lt;b&gt;UC-17 Evaluate Defender Performance&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-17] Evaluate Defender Performance&#10;Priority: Medium | Criticality: Important&#10;Trigger: Operator requests evaluation of specific defender agent&#10;Actors: Researcher/Operator&#10;Description: Evaluates RL-trained or rule-based defender against standardized held-out test scenarios. Outputs comparison metrics.">
                    <mxGeometry x="1180" y="760" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n18" value="&lt;b&gt;UC-18 Train RL Defender Agent&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-18] Train RL Defender Agent&#10;Priority: Medium | Criticality: Important&#10;Trigger: Training script invoked&#10;Actors: Batch Runner&#10;Description: Gymnasium-wrapped environment trains defender policy using PPO and Stable Baselines3. Defender observes only fused sensor data.">
                    <mxGeometry x="1180" y="840" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n19" value="&lt;b&gt;UC-16 Run Headless Batch Episodes&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-16] Run Headless Batch Episodes&#10;Priority: Medium | Criticality: Important&#10;Trigger: Training script or operator requests N batch episodes&#10;Actors: Batch Runner&#10;Description: Automated script executes N episodes end-to-end on real PX4/Gazebo/ROS 2 stack in headless Docker with seeded scenarios and full logging.">
                    <mxGeometry x="790" y="700" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n20" value="&lt;b&gt;UC-13 Record Episode Telemetry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=18;align=center;fontStyle=1;" parent="1" vertex="1" tooltip="[UC-13] Record Episode Telemetry&#10;Priority: High | Criticality: Essential&#10;Trigger: Mission starts (auto log) or operator clicks 'Start Recording'&#10;Actors: Researcher/Operator&#10;Description: Telemetry_logger records mission events, 4-drone telemetry, fused tracks, attack conditions, and outcome into SQLite database at 10 Hz.">
                    <mxGeometry x="790" y="830" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n21" value="&lt;b&gt;System Admin&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=19;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="150" y="190" width="50" height="95" as="geometry"/>
                </mxCell>
