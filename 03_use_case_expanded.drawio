                <mxCell id="c5" value="IntelliSwarm Simulation Platform" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="182" width="1460" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="&lt;b&gt;Level&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="244" width="300" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c7" value="User goal" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="244" width="1460" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c8" value="&lt;b&gt;Primary Actor&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="306" width="300" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c9" value="Operator (Mission Commander role)" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="306" width="1460" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c10" value="&lt;b&gt;Stakeholders and Interests&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="368" width="300" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="c11" value="Operator — wants the engagement flown and adjudicated without touching the simulator directly.&lt;br&gt;Data Analyst — wants every tick recorded so the run can be replayed and compared.&lt;br&gt;Batch Runner — reuses this use case unattended, once per episode." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="368" width="1460" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="c12" value="&lt;b&gt;Preconditions&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="484" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c13" value="The simulation stack is running and healthy, four aircraft are spawned, and the attacker and defender bases have been placed and acknowledged." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="484" width="1460" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c14" value="&lt;b&gt;Success Guarantee&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="564" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c15" value="The mission is adjudicated with a recorded winner, every aircraft has landed, and the episode is closed in the database with its per tick telemetry." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="564" width="1460" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c16" value="&lt;b&gt;Trigger&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="644" width="300" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c17" value="The Operator selects Start Duel in the Ground Control Station." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="340" y="644" width="1460" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="c18" value="&lt;b&gt;Main Success Scenario&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="706" width="1760" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c19" value="&lt;b&gt;Actor Action (or Intention)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="758" width="700" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c20" value="&lt;b&gt;System Responsibility&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="740" y="758" width="1060" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c21" value="1. Operator selects Start Duel, choosing the mission mode, the targeting policy and the defender guidance." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="814" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c22" value="2. Validates the request, confirms the bases are acknowledged, and opens a new episode." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="814" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c23" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="882" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c24" value="3. Arms all four aircraft and places them in offboard mode." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="882" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c25" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="950" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c26" value="4. Begins the guidance loop at 10 Hz." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="950" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c27" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1018" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c28" value="5. Reads the fused sensor tracks, never the simulator's ground truth." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1018" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c29" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1086" width="700" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="c30" value="6. Steers each attacker toward the defended base at 6 m/s with potential field evasion, and each defender by lead collision intercept at 9 m/s." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1086" width="1060" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="c31" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1178" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c32" value="7. Publishes a trajectory setpoint to all four aircraft and records the tick." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1178" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c33" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1246" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c34" value="8. Marks an attacker neutralised when its assigned defender closes within 3 m." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1246" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c35" value="9. Operator watches the engagement on the dashboard." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1314" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c36" value="10. Streams positions, fused tracks and threat ranking while the loop runs." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1314" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c37" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1382" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c38" value="11. Adjudicates the outcome once an attacker is neutralised, a base is breached, or the time limit expires." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1382" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c39" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1450" width="700" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c40" value="12. Lands every aircraft, closes the episode and publishes the final mission status." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1450" width="1060" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c41" value="&lt;b&gt;Extensions (Alternate Flows)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1518" width="1760" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c42" value="&lt;b&gt;Condition&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1570" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c43" value="&lt;b&gt;System Response&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1570" width="1060" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c44" value="3a. An aircraft refuses to arm." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1620" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c45" value="The system aborts the start, reports which aircraft failed, and leaves the episode unopened." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1620" width="1060" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c46" value="4a. An attack condition is active." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1692" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c47" value="Degradation is applied between detection and fusion, so the defenders fly on a corrupted picture. The mission proceeds unchanged." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1692" width="1060" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c48" value="6a. A defender holds no track." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1764" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c49" value="It flies on the team picture rather than its own view, and the tick is recorded as coasting." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1764" width="1060" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c50" value="11a. No side resolves before the time limit." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1836" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c51" value="The mission is adjudicated a timeout and recorded as undecided." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1836" width="1060" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c52" value="&lt;b&gt;Special Requirements&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2.5;align=left;spacingLeft=12;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1908" width="1760" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c53" value="The guidance loop runs at 10 Hz. Guidance reads fused tracks only. Every stored value is a real reading or NULL." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1960" width="1760" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c54" value="Fully dressed format with the two column variation of the main success scenario (Larman, Applying UML and Patterns, sections 6.5 and 6.6). The remaining seventeen use cases are held in the same form in the SRS." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#000000;fontSize=17;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2056" width="1760" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>