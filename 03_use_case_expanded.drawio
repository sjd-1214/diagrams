                <mxCell id="c3" value="&lt;b&gt;UC-06  Launch 2v2 Swarm Duel Mission&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
